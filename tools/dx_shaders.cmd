@echo off
rem Compile src\kernels_dx.hlsl and kernels_dx_token.hlsl into src\kernels_dx.h (DXBC bytecode for gpu_d3d12.c).
rem Needs fxc.exe from the Windows SDK; the generated header is committed, so normal builds do not.
setlocal
cd /d "%~dp0.."
set "FXC=fxc"
where fxc >nul 2>nul || set "FXC=%ProgramFiles(x86)%\Windows Kits\10\bin\10.0.26100.0\x64\fxc.exe"
set OUT=src\kernels_dx.h
echo /* kernels_dx.h - generated by tools\dx_shaders.cmd from kernels_dx.hlsl: do not edit. */> %OUT%
for %%e in (mm_q4_K mm_q6_K mv_q4_K mv_q6_K) do (
    "%FXC%" /nologo /O3 /Qstrip_reflect /Qstrip_debug /T cs_5_0 /E %%e /Vn g_%%e /Fh %TEMP%\pithos_%%e.h src\kernels_dx.hlsl >nul || goto fail
    type %TEMP%\pithos_%%e.h >> %OUT%
    del %TEMP%\pithos_%%e.h
)
for %%e in (resid_norm quant silu_quant shortconv attn_prep attention conv_chunk conv_state attn_chunk) do (
    "%FXC%" /nologo /O3 /Qstrip_reflect /Qstrip_debug /T cs_5_0 /E %%e /Vn g_%%e /Fh %TEMP%\pithos_%%e.h src\kernels_dx_token.hlsl >nul || goto fail
    type %TEMP%\pithos_%%e.h >> %OUT%
    del %TEMP%\pithos_%%e.h
)
echo [dx] ok: %OUT%
exit /b 0
:fail
echo [dx] shader compilation failed
exit /b 1
