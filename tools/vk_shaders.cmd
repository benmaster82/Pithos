@echo off
rem Compile src\kernels_dx.hlsl and kernels_dx_token.hlsl into src\kernels_vk.h (SPIR-V for gpu_vulkan.c).
rem The same sources as tools\dx_shaders.cmd; registers map to Vulkan bindings u0..u2 -> 0..2,
rem t0 t1 -> 8 9, b0 -> 16. Needs a dxc.exe built with SPIR-V support (the release from
rem github.com/microsoft/DirectXShaderCompiler; the Windows SDK one has none): set DXC=path\dxc.exe
rem or unpack it into ..\tools\dxc. The generated header is committed, so normal builds do not need it.
setlocal
cd /d "%~dp0.."
if not defined DXC set "DXC=%~dp0..\..\tools\dxc\bin\x64\dxc.exe"
if not exist "%DXC%" (
    echo [vk] dxc.exe with SPIR-V support not found: set DXC
    exit /b 1
)
rem The defines select Vulkan's aligned block layouts (Q8_BYTES etc. in gpu_vulkan.c).
set OPT=-spirv -T cs_6_0 -O3 -fspv-target-env=vulkan1.1 -fvk-t-shift 8 0 -fvk-b-shift 16 0 -D PITHOS_VK -D Q8_BYTES=272 -D Q8_D=256 -D Q8_QS=0 -D Q6K_BYTES=224 -D Q6_D=208 -D Q6_QL=0 -D Q6_QH=128 -D Q6_SC=192
set OUT=src\kernels_vk.h
echo /* kernels_vk.h - generated by tools\vk_shaders.cmd from kernels_dx.hlsl and kernels_dx_token.hlsl: do not edit. */> %OUT%
for %%e in (mm_q4_K mm_q6_K mv_q4_K mv_q6_K) do (
    "%DXC%" %OPT% -E %%e -Vn g_vk_%%e -Fh %TEMP%\pithos_vk_%%e.h src\kernels_dx.hlsl >nul || goto fail
    type %TEMP%\pithos_vk_%%e.h >> %OUT%
    del %TEMP%\pithos_vk_%%e.h
)
for %%e in (resid_norm quant silu_quant shortconv attn_prep attention conv_chunk conv_state attn_chunk) do (
    "%DXC%" %OPT% -E %%e -Vn g_vk_%%e -Fh %TEMP%\pithos_vk_%%e.h src\kernels_dx_token.hlsl >nul || goto fail
    type %TEMP%\pithos_vk_%%e.h >> %OUT%
    del %TEMP%\pithos_vk_%%e.h
)
echo [vk] ok: %OUT%
exit /b 0
:fail
echo [vk] shader compilation failed
exit /b 1
